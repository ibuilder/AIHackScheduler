# BBSchedule environment configuration
#
# Copy to .env and fill in what you need. Only SESSION_SECRET is required, and
# only in production — development supplies a default and falls back to SQLite.
# Every variable below is read somewhere in the codebase; nothing here is decorative.

# ── Required ──────────────────────────────────────────────────────────────────

# Signs session cookies and CSRF tokens. Production refuses to start without it.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-before-deploying

# ── Core ──────────────────────────────────────────────────────────────────────

# development | testing | production
FLASK_ENV=development

# Omit in development to use sqlite:///bbschedule-dev.db.
# Required in production.
# DATABASE_URL=postgresql://username:password@localhost/bbschedule

# Caching, rate-limit storage, and the Celery broker. Optional; rate limiting
# falls back to in-process memory and caching to a simple in-process cache.
# REDIS_URL=redis://localhost:6379/0

# Set to 1 to echo every SQL statement during development.
# SQL_ECHO=0

# Where uploaded schedule files land.
# UPLOAD_FOLDER=uploads

# ── Azure AI / Foundry (optional) ─────────────────────────────────────────────
# Without these, schedule analysis and forecasting return a clear
# "integration unavailable" response. CPM and schedule quality still work —
# they are computed locally and need no external service.

# FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com/
# FOUNDRY_API_KEY=
# FOUNDRY_MODEL_NAME=gpt-4o

# ── Azure platform services (optional) ────────────────────────────────────────

# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=

# ── Microsoft Fabric (optional) ───────────────────────────────────────────────

# FABRIC_WORKSPACE_ID=
# FABRIC_CLIENT_ID=
# FABRIC_CLIENT_SECRET=

# ── Power BI (optional) ───────────────────────────────────────────────────────

# POWERBI_CLIENT_ID=
# POWERBI_CLIENT_SECRET=
# POWERBI_TENANT_ID=

# ── Email (optional) ──────────────────────────────────────────────────────────

# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=

# ── Operations (optional) ─────────────────────────────────────────────────────

# LOG_LEVEL=INFO
# SENTRY_DSN=
# BACKUP_S3_BUCKET=
