# Normalise line endings so a checkout on Windows does not produce files that
# fail inside a Linux container.

* text=auto

# A shell script with CRLF endings fails with "bad interpreter: no such file or
# directory" when the container tries to run it. These must stay LF everywhere,
# including in a Windows working tree.
*.sh text eol=lf
deployment/entrypoint.sh text eol=lf

# Dockerfiles and compose files are read by Linux tooling.
Dockerfile text eol=lf
*.dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-only helpers keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary, never converted. `* text=auto` above leaves these to Git's own
# content detection, which is a heuristic — and tests/data/example.mpp is a real
# Microsoft Project file, an OLE2 compound document that must survive a checkout
# byte for byte. tests/test_fixtures.py checks its hash on every Python version.
*.png binary
*.jpg binary
*.ico binary
*.db binary
*.sqlite3 binary
*.mpp binary
*.mpx binary
